msgstr "Error de actualización, vea el registro abajo."

msgid "Update skipped: another update is already running."
msgstr "Actualización omitida: ya se está ejecutando otra actualización."

msgid "Update started, reading progress..."
msgstr "Actualización iniciada, leyendo progreso..."

msgid "Update to latest now"
msgstr "Actualizar ahora a la última versión"

