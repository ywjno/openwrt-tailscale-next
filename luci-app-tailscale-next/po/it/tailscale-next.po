msgid "Accept subnet routes"
msgstr "Accetta route di sottorete"

msgid "Advertise as exit node"
msgstr "Annuncia come exit node"

msgid "Advertise routes"
msgstr "Annuncia route"

msgid "Advertise routes must be a comma-separated list of IP subnets (e.g. 10.0.0.0/24)"
msgstr "Le route da annunciare devono essere un elenco di sottoreti IP separato da virgole (ad es. 10.0.0.0/24)"

