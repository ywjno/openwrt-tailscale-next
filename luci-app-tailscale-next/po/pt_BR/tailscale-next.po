msgstr "Ainda sem saída de log. Resposta de início: %s"

msgid "Node"
msgstr "Nó"

msgid "Not running"
msgstr "Não está em execução"

msgid "Number of update backups kept on this device (0 disables backups)."
msgstr "Número de backups de atualização mantidos neste dispositivo (0 desativa os backups)."

msgid "One click replaces the tailscale/tailscaled binaries with the latest upstream release; init scripts, UCI config and login state are preserved."
msgstr "Um clique substitui os binários tailscale/tailscaled pela versão mais recente do upstream; os scripts init, a configuração UCI e o estado de login são preservados."

msgid "Requirements: RAM 128 MB minimum (256 MB recommended), 10 MB free on /overlay (37 MB with update backups), 30 MB free on /tmp for automatic updates."
msgstr "Requisitos: 128 MB de RAM no mínimo (256 MB recomendados), 10 MB livres em /overlay (37 MB com backups de atualização), 30 MB livres em /tmp para atualizações automáticas."

msgid "Roll back"
msgstr "Reverter"

msgid "Roll back to the last backed-up Tailscale version?"
msgstr "Reverter para a última versão do Tailscale em backup?"

msgid "Running"
msgstr "Em execução"

