msgid "(waiting for log...)"
msgstr "(aguardando log...)"

msgid "Accept subnet routes"
msgstr "Aceitar rotas de sub-rede"

msgid "Advertise as exit node"
msgstr "Anunciar como nó de saída"

msgid "Advertise routes"
msgstr "Anunciar rotas"

msgid "Advertise routes must be a comma-separated list of IP subnets (e.g. 10.0.0.0/24)"
msgstr "As rotas anunciadas devem ser uma lista de sub-redes IP separada por vírgulas (ex.: 10.0.0.0/24)"

msgid "Allow LAN access while using an exit node"
msgstr "Permitir acesso à LAN ao usar um nó de saída"

msgid "Architecture"
msgstr "Arquitetura"

msgid "Auth key"
msgstr "Chave de autenticação"

msgid "Auth key, leave empty to disable"
msgstr "Chave de autenticação, deixe vazio para desativar"

msgid "Authenticate"
msgstr "Autenticar"

msgid "Auto update"
msgstr "Atualização automática"

msgid "Backups to keep"
msgstr "Backups a manter"

msgid "Bound user"
msgstr "Usuário vinculado"

msgid "Check for and install updates automatically every day at 04:30"
msgstr "Verificar e instalar atualizações automaticamente todos os dias às 04:30"

msgid "Check for updates"
msgstr "Verificar atualizações"

msgid "Check for updates whenever this page is loaded."
msgstr "Verificar atualizações sempre que esta página for carregada."

msgid "Check timed out, please try again"
msgstr "A verificação expirou, tente novamente"

msgid "Checking for updates..."
msgstr "Verificando atualizações..."

msgid "Custom Server"
msgstr "Servidor personalizado"

msgid "Device requirements"
msgstr "Requisitos do dispositivo"

msgid "Enable"
msgstr "Ativar"

msgid "Enable \"Check for updates\" above to check automatically."
msgstr "Ative \"Verificar atualizações\" (acima) para verificar automaticamente."

msgid "Enable the service above to show the settings."
msgstr "Ative o serviço acima para exibir as configurações."

msgid "Exit node must be a Tailscale IP or node name, not a subnet (e.g. 100.64.0.1 or my-exit-node)"
msgstr "O nó de saída deve ser um IP Tailscale ou nome de nó, não uma sub-rede (ex.: 100.64.0.1 ou my-exit-node)"

msgid "Exit node name or IP; leave empty to disable"
msgstr "Nome ou IP do nó de saída; deixe vazio para desativar"

msgid "Exit node that routes traffic for this device: Tailscale IP (100.x.x.x) or node name, not a subnet. Leave empty to disable."
msgstr "Nó de saída para o tráfego deste dispositivo: IP Tailscale (100.x.x.x) ou nome do nó, não uma sub-rede. Vazio para desativar."

msgid "Failed to read status: %s"
msgstr "Falha ao ler o status: %s"

msgid "For details see"
msgstr "Para detalhes veja"

msgid "Global Settings"
msgstr "Configurações globais"

msgid "Headscale server URL, leave empty to disable"
msgstr "URL do servidor Headscale, deixe vazio para desativar"

msgid "Hostname"
msgstr "Nome do host"

msgid "IP addresses, comma separated"
msgstr "Endereços IP, separados por vírgulas"

msgid "Installed version"
msgstr "Versão instalada"

msgid "Latest version"
msgstr "Versão mais recente"

msgid "Leave empty to use the device hostname"
msgstr "Deixe vazio para usar o nome do dispositivo"

msgid "Let other tailnet devices route their internet traffic through this router; approve the exit node in the Tailscale admin console."
msgstr "Permite que outros dispositivos do tailnet roteiem o tráfego de internet por este roteador; aprove o nó de saída no console de administração do Tailscale."

msgid "Loading status..."
msgstr "Carregando estado..."

msgid "Log"
msgstr "Log"

msgid "Log out and unbind"
msgstr "Sair e desvincular"

msgid "Log out and unbind the current device?"
msgstr "Sair e desvincular este dispositivo?"

msgid "Login"
msgstr "Login"

msgid "Low"
msgstr "Baixo"

msgid "Memory"
msgstr "Memória"

msgid "Needs login"
msgstr "Requer login"

msgid "Needs machine auth"
msgstr "Requer autorização do dispositivo"

msgid "No backup available on this device."
msgstr "Não há backup disponível neste dispositivo."

