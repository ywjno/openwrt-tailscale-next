#!/bin/sh
#
# tailscale-next-update — OpenWrt Tailscale binary updater (MIT, part of
# luci-app-tailscale-next; adapted from istoreos-tailscale-updater, MIT,
# github.com/xialiu000). POSIX sh / busybox; needs only a downloader
# (curl/wget/uclient-fetch), tar, gzip and sha256.
#
# Exit codes: 0 = success (or nothing to do), 1 = error,
#             3 = skipped because another update is already in progress.
set -u

APP="tailscale-next-update"
PROG="$0"
BASE_URL_DEFAULT="https://pkgs.tailscale.com/stable"

# ---- download source -------------------------------------------------------
# github  : CH3NGYZ/small-tailscale-openwrt releases (UPX-compressed combined
#           binary + SHA256SUMS.txt + version.txt via releases/latest/download)
# official: pkgs.tailscale.com tarballs (override with --base-url)
SOURCE="github"
SOURCE_EXPLICIT=0
HAVE_BASE_URL=0
GITHUB_REPO="${TS_GITHUB_REPO:-CH3NGYZ/small-tailscale-openwrt}"
# GH_ROOT is a base: the release path is appended per fetch. Mirrors
# (TS_GH_MIRRORS env or --mirror-list file) are tried per file after it.
GH_ROOT="${TS_GH_DL_BASE:-https://github.com}"
GH_SUFFIX="/$GITHUB_REPO/releases/latest/download"
GH_MIRRORS="${TS_GH_MIRRORS:-}"
MIRROR_LIST_FILE=""
# VANILLA: uncompressed variants of the combined binary (upx -d output,
# published on this project's release) — no per-invocation UPX decompress
# cost. version-vanilla.txt pins the version so checks stay consistent.
VANILLA_REPO="${TS_VANILLA_REPO:-ywjno/openwrt-tailscale-next}"
VANILLA_ROOT="${TS_VANILLA_DL_BASE:-https://github.com}"
VANILLA_SUFFIX="/$VANILLA_REPO/releases/latest/download"
VANILLA_MIN_KB="${TS_VANILLA_MIN_KB:-61440}"

# ---- paths (overridable for testing) ------------------------------------
BINDIR="${TS_BINDIR:-/usr/sbin}"
INITD="${TS_INITD:-/etc/init.d/tailscale-next}"
CONFDIR="${TS_CONFDIR:-/etc/tailscale}"
BACKUP_ROOT="$CONFDIR/.update-backup"
STATE_FILE="$CONFDIR/.update-state"
WORKDIR_OVERRIDE="${TS_WORKDIR:-}"
NO_SERVICE="${TS_NO_SERVICE:-0}"

# files used by the LuCI frontend (--start / --json)
LOG_FILE="${TS_LOG:-/tmp/tailscale-next-update.log}"
RC_FILE="${TS_RC:-/tmp/tailscale-next-update.rc}"
UI_STATUS_FILE="${TS_UI_STATUS:-/tmp/tailscale-next-update.status}"

# ---- options -------------------------------------------------------------
ARCH_OVERRIDE=""
TARGET_VERSION=""
MODE="update"          # update | check | rollback | list-backups
FORCE=0
DRY_RUN=0
ASSUME_YES=0
NO_HOLD=0
JSON_OUT=0
# backup generations to keep (0 = no backups); TS_KEEP_BACKUPS override
case "${TS_KEEP_BACKUPS:-}" in
	''|*[!0-9]*) KEEP_BACKUPS=3 ;;
	*) KEEP_BACKUPS="$TS_KEEP_BACKUPS" ;;
esac
BASE_URL="$BASE_URL_DEFAULT"
CONNECT_TIMEOUT=20

# =========================================================================
# logging
# =========================================================================
if [ -t 1 ] && [ "${TS_NO_COLOR:-0}" != 1 ]; then
	C_R="$(printf '\033[31m')"; C_G="$(printf '\033[32m')"
	C_Y="$(printf '\033[33m')"; C_B="$(printf '\033[1m')"; C_0="$(printf '\033[0m')"
else
	C_R=""; C_G=""; C_Y=""; C_B=""; C_0=""
fi

# curl's progress meter garbages a redirected log (LuCI background run);
# keep it only on a real tty.
if [ -t 2 ]; then CURL_QUIET=""; else CURL_QUIET="-sS"; fi

log()  { printf '%s\n' "$*"; }
info() { printf '%s[i]%s %s\n' "$C_B" "$C_0" "$*"; }
ok()   { printf '%s[+]%s %s\n' "$C_G" "$C_0" "$*"; }
warn() { printf '%s[!]%s %s\n' "$C_Y" "$C_0" "$*" >&2; }
err()  { printf '%s[x]%s %s\n' "$C_R" "$C_0" "$*" >&2; }
die()  { err "$*"; exit 1; }

# minimal JSON escaping for --check --json (version/arch carry no control chars)
json_escape() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

usage() {
	cat <<EOF
$APP — update OpenWrt's Tailscale binaries to current upstream releases

Sources:
  github   (default) UPX-compressed combined binary from
           $GITHUB_REPO releases
           (8 arches; no riscv64). Install = real file tailscaled
           + tailscale symlink.
  official pkgs.tailscale.com tarballs (override with --base-url;
           implies --source official unless --source is given).

Usage: $PROG [options]

Options:
  -c, --check             Only compare installed vs latest, change nothing.
  -v, --version <ver>     Install a specific Tailscale version (e.g. 1.104.1).
      --latest            Explicitly use the newest stable (default).
  -n, --dry-run           Show what would happen, download/install nothing.
  -f, --force             Reinstall even if already at/above target.
  -y, --yes               Do not prompt for confirmation.
  -a, --arch <arch>       Override detected arch (amd64|arm64|arm|mips|mipsle|
                          mips64|mips64le|riscv64|386).
      --source <which>    github (default) or official.
      --base-url <url>    Alternate official-layout mirror (implies
                          --source official).
      --mirror-list <f>   github source only: file with extra mirror base
                          URLs (one per line, https://...), tried after the
                          direct root. Env: TS_GH_MIRRORS (space separated).
                          Mirrors must relay unmodified content: the
                          checksum file is also fetched per mirror.
      --no-hold           Do not ask opkg to hold the tailscale package.
      --bindir <dir>      Binary dir (default $BINDIR).
      --workdir <dir>     Scratch dir (default: auto-picked writable dir).
      --rollback          Restore the most recent backup and restart.
      --list-backups      List available backups.
  -h, --help              This help.

Examples:
  $PROG --check
  $PROG
  $PROG -v 1.104.1
  $PROG --source official --base-url https://pkgs.tailscale.com/unstable
  $PROG --dry-run
  $PROG --rollback
EOF
}

# =========================================================================
# helpers
# =========================================================================
need_root() {
	# real system dirs need root; an overridden --bindir means sandbox mode
	[ "$BINDIR" = "/usr/sbin" ] || return 0
	[ "$(id -u 2>/dev/null || echo 1)" = "0" ] || die "must run as root (try: sudo $PROG)"
}

have() { command -v "$1" >/dev/null 2>&1; }

# Print first line of a URL (curl -> wget -> uclient-fetch). Every transfer
# has a stall guard: curl aborts <10KB/s for 60s, wget/uclient a 60s read
# timeout — a wedged transfer must not hang cron runs.
fetch_stdout() {
	_url="$1"
	if have curl; then
		curl -fsSL --connect-timeout "$CONNECT_TIMEOUT" \
			--speed-limit 10240 --speed-time 60 --retry 2 "$_url"
	elif have uclient-fetch; then
		uclient-fetch -q -T 60 -O - "$_url"
	elif have wget; then
		wget -q -T 60 -O - "$_url"
	else
		return 127
	fi
}

# Download URL to file. Returns non-zero on failure.
fetch_file() {
	_url="$1"; _out="$2"
	rm -f "$_out"
	if have curl; then
		curl -fSL $CURL_QUIET --connect-timeout "$CONNECT_TIMEOUT" \
			--speed-limit 10240 --speed-time 60 --retry 3 -o "$_out" "$_url"
	elif have uclient-fetch; then
		uclient-fetch -q -T 60 -O "$_out" "$_url"
	elif have wget; then
		wget -q -T 60 -O "$_out" "$_url"
	else
		fetch_stdout "$_url" > "$_out" || { rm -f "$_out"; return 127; }
	fi
	[ -s "$_out" ]
}

# Map a package-manager arch string (preferred) or uname -m to Tailscale's.
detect_arch() {
	if [ -n "$ARCH_OVERRIDE" ]; then printf '%s\n' "$ARCH_OVERRIDE"; return 0; fi

	_owrt=""
	if have apk; then
		_owrt="$(apk --print-arch 2>/dev/null | head -n1)"
	fi
	if [ -z "$_owrt" ] && have opkg; then
		_owrt="$(opkg print-architecture 2>/dev/null | awk '/^arch /{print $2}' | tail -n1)"
	fi
	if [ -z "$_owrt" ] && have opkg-config; then
		_owrt="$(opkg-config --arch 2>/dev/null | head -n1)"
	fi

	_map() {
		case "$1" in
			x86_64|amd64)                echo amd64 ;;
			i386_*|i486_*|i586_*|i686_*|i386|i486|i586|i686) echo 386 ;;
			aarch64*)                    echo arm64 ;;
			arm*)                        echo arm ;;
			mips64el*|mips64le*)         echo mips64le ;;
			mips64*)                     echo mips64 ;;
			mipsel*)                     echo mipsle ;;
			mips_*|mips|mips32*)         echo mips ;;
			riscv64*)                    echo riscv64 ;;
			*)                           return 1 ;;
		esac
	}

	if [ -n "$_owrt" ]; then
		_arch="$(_map "$_owrt")" && { printf '%s\n' "$_arch"; return 0; }
	fi

	_arch="$(_map "$(uname -m)")" && { printf '%s\n' "$_arch"; return 0; }
	return 1
}

# ---- github source: base chain (direct + mirrors) --------------------------
# Files are fetched and checksum-verified per base, so a corrupt mirror is
# skipped. The sums file also comes per base: a malicious mirror could pair
# a fake binary with matching sums - same trust model as upstream; only add
# mirrors you trust to relay unmodified content.
gh_bases() {
	printf '%s\n' "$GH_ROOT" | sed 's|/*$||'
	for _m in $GH_MIRRORS; do printf '%s\n' "$_m" | sed 's|/*$||'; done
	if [ -n "$MIRROR_LIST_FILE" ] && [ -f "$MIRROR_LIST_FILE" ]; then
		grep -E '^https?://' "$MIRROR_LIST_FILE" 2>/dev/null | sed 's|/*$||'
	fi
}

gh_url() { # <base> <name>
	printf '%s%s/%s\n' "$1" "$GH_SUFFIX" "$2"
}

vanilla_url() { # <name>
	printf '%s%s/%s\n' "$VANILLA_ROOT" "$VANILLA_SUFFIX" "$1"
}

# decide once per run: vanilla avoids the dominant transient allocation
# (UPX decompress) on low-RAM devices; github source only
VANILLA_MODE=0
vanilla_decide() {
	[ "${_VANILLA_DECIDED:-0}" = 1 ] && return 0
	_VANILLA_DECIDED=1
	[ "$SOURCE" = github ] || return 0
	_avail="$(df -k "$BINDIR" 2>/dev/null | awk 'NR==2{print $4}')"
	if [ -n "$_avail" ]; then
		if [ "$_avail" -ge "$VANILLA_MIN_KB" ] 2>/dev/null; then
			VANILLA_MODE=1
		fi
	fi
	return 0
}

# fetch a URL to stdout, 3 attempts 2s apart: version endpoints and
# release-asset redirects occasionally drop a request
fetch_retry() {
	_i=0
	while [ "$_i" -lt 3 ]; do
		_i=$((_i + 1))
		if _out="$(fetch_stdout "$1" 2>/dev/null)" && [ -n "$_out" ]; then
			printf '%s\n' "$_out"
			return 0
		fi
		[ "$_i" -lt 3 ] && sleep 2
	done
	return 1
}

# latest stable: github reads version.txt across the base chain; official
# reads the pkgs.tailscale.com JSON index
get_latest_version() {
	vanilla_decide
	if [ "$SOURCE" = github ]; then
		if [ "$VANILLA_MODE" = 1 ]; then
			_v="$(fetch_retry "$(vanilla_url version-vanilla.txt)" | head -n1 | tr -d ' \r')"
			_v="${_v#v}"
			[ -n "$_v" ] || return 1
			printf '%s\n' "$_v"
			return 0
		fi
		_v=""
		for _base in $(gh_bases); do
			_v="$(fetch_retry "$(gh_url "$_base" version.txt)" | head -n1 | tr -d ' \r')"
			[ -n "$_v" ] && break
		done
		_v="${_v#v}"   # the repo's version.txt carries a leading "v"
		[ -n "$_v" ] || return 1
		printf '%s\n' "$_v"
		return 0
	fi
	_j="$(fetch_retry "$BASE_URL/?mode=json")" || return 1
	_v="$(printf '%s' "$_j" | sed -n 's/.*"TarballsVersion"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1)"
	[ -n "$_v" ] || return 1
	printf '%s\n' "$_v"
}

# installed version from the CLI symlink in BINDIR (empty if not installed)
current_version() {
	[ -x "$BINDIR/tailscale" ] || return 1
	"$BINDIR/tailscale" version 2>/dev/null | head -n1 | tr -d ' \r'
}

# is $1 strictly greater than $2 ? (dotted numeric, ignores suffixes)
version_gt() {
	awk -v a="$1" -v b="$2" 'BEGIN{
		n=split(a,x,"."); m=split(b,y,".");
		k=(n>m)?n:m;
		for(i=1;i<=k;i++){
			xi=x[i]+0; yi=y[i]+0;
			if(xi>yi){print "1"; exit}
			if(xi<yi){print "0"; exit}
		}
		print "0"
	}'
}

# pick a scratch dir with enough free space: extracted binaries (official
# ~65-90MB; the tarball streams through a fifo) or the single github binary
# (~10MB). Fail fast before /tmp (tmpfs = RAM) fills with an unfit download.
prepare_workdir() {
	_need=150000            # KB, official source
	[ "$SOURCE" = github ] && _need=30000
	if [ -n "$WORKDIR_OVERRIDE" ]; then
		mkdir -p "$WORKDIR_OVERRIDE" || die "cannot create $WORKDIR_OVERRIDE"
		printf '%s\n' "$WORKDIR_OVERRIDE"; return 0
	fi
	for d in /tmp /overlay /mnt /mnt/sda1 /etc/tailscale; do
		[ -d "$d" ] || continue
		avail="$(df -k "$d" 2>/dev/null | awk 'NR==2{print $4}')"
		[ -n "$avail" ] || continue
		if [ "$avail" -ge "$_need" ] 2>/dev/null; then
			_w="$d/tailscale-update.$$"
			mkdir -p "$_w" 2>/dev/null && { printf '%s\n' "$_w"; return 0; }
		fi
	done
	die "no scratch dir with >=$((_need / 1000))MB free (use --workdir to point at a data volume)"
}

# compute sha256 of $1 with whatever is available
_sha256_of() {
	if have sha256sum; then
		sha256sum "$1" | awk '{print $1}'
	elif have busybox; then
		busybox sha256sum "$1" | awk '{print $1}'
	elif have openssl; then
		openssl dgst -sha256 "$1" | awk '{print $NF}'
	else
		return 1
	fi
}

install_file() {
	# install_file <src> <dst> <mode>
	if have install; then
		install -m "$3" "$1" "$2"
	else
		cp -f "$1" "$2" && chmod "$3" "$2"
	fi
}

service_stop() {
	[ "$NO_SERVICE" = 1 ] && { info "skipping service stop (TS_NO_SERVICE=1)"; return 0; }
	if [ -x "$INITD" ]; then
		info "stopping tailscale service"
		"$INITD" stop >/dev/null 2>&1 || true
		# give procd a moment, then make sure nothing lingers on the old binary
		sleep 1
		if have pidof; then pidof tailscaled >/dev/null 2>&1 && { sleep 1; } ; fi
	fi
	return 0
}

service_start() {
	[ "$NO_SERVICE" = 1 ] && { info "skipping service start (TS_NO_SERVICE=1)"; return 0; }
	if [ -x "$INITD" ]; then
		info "starting tailscale service"
		"$INITD" start >/dev/null 2>&1 || "$INITD" restart >/dev/null 2>&1 || true
		sleep 2
	fi
	return 0
}

hold_package() {
	[ "$NO_HOLD" = 1 ] && return 0
	# Keep the package manager from clobbering our binaries on its next upgrade.
	if have opkg && opkg status tailscale >/dev/null 2>&1; then
		opkg flag hold tailscale tailscaled >/dev/null 2>&1 \
			&& info "opkg: tailscale/tailscaled flagged 'hold'" \
			|| warn "could not set opkg hold flag"
	fi
	# apk (OpenWrt 24.10+ apk builds) has no simple hold; note it.
	if have apk && apk info -e tailscale >/dev/null 2>&1; then
		warn "apk build: 'apk upgrade' could reinstall the feed version; re-run this tool if it does"
	fi
}

# interlock between update entry points (LuCI --start, -y, cron): mkdir is
# atomic; staleness uses the same 30-minute budget as the UI guard above.
LOCK_DIR="${TS_LOCKDIR:-/tmp/tailscale-next-update.lock}"

lock_is_held() { # 0 = a live lock exists; stale locks are cleared, returning 1
	[ -d "$LOCK_DIR" ] || return 1
	if [ -z "$(find "$LOCK_DIR/held" -mmin -30 2>/dev/null)" ]; then
		warn "stale update lock (crashed update?); removing"
		rm -rf "$LOCK_DIR"
		return 1
	fi
	return 0
}

acquire_lock() {
	if lock_is_held; then return 1; fi
	mkdir "$LOCK_DIR" 2>/dev/null || return 1
	touch "$LOCK_DIR/held"
	return 0
}

# =========================================================================
# backup / restore
# =========================================================================
make_backup() {
	_cur="$1"
	# 0 disables backups: BACKUP_DIR stays empty (state records backup=) and
	# rollback reports none available
	if [ "$KEEP_BACKUPS" -lt 1 ] 2>/dev/null; then
		BACKUP_DIR=""
		info "backup skipped (keep backups = 0)"
		return 0
	fi
	_ts="$(date +%Y%m%d-%H%M%S)"
	BACKUP_DIR="$BACKUP_ROOT/$_ts"
	mkdir -p "$BACKUP_DIR" || die "cannot create backup dir $BACKUP_DIR"
	_symlink=0; [ -L "$BINDIR/tailscale" ] && _symlink=1
	for b in tailscaled tailscale; do
		# record the tailscale symlink via a meta flag, not -L: backing up
		# both files doubles flash; restore recreates the link from the flag
		if [ "$b" = tailscale ] && [ "$_symlink" = 1 ]; then
			continue
		fi
		if [ -e "$BINDIR/$b" ]; then
			cp -pL "$BINDIR/$b" "$BACKUP_DIR/$b" || die "backup of $b failed"
		fi
	done
	printf 'version=%s\ndate=%s\nbindir=%s\nsymlink=%s\n' \
		"${_cur:-unknown}" "$_ts" "$BINDIR" "$_symlink" > "$BACKUP_DIR/meta"
	ok "backup saved to $BACKUP_DIR (was ${_cur:-unknown})"
	prune_backups
}

prune_backups() {
	[ -d "$BACKUP_ROOT" ] || return 0
	_ls="$(ls -1d "$BACKUP_ROOT"/*/ 2>/dev/null | sort)"
	_n="$(printf '%s\n' "$_ls" | grep -c . )"
	[ "$_n" -le "$KEEP_BACKUPS" ] 2>/dev/null && return 0
	printf '%s\n' "$_ls" | head -n $(( _n - KEEP_BACKUPS )) | while read -r d; do
		[ -n "$d" ] && rm -rf "$d"
	done
}

latest_backup() {
	ls -1d "$BACKUP_ROOT"/*/ 2>/dev/null | sort | tail -n1
}

do_list_backups() {
	if [ ! -d "$BACKUP_ROOT" ] || [ -z "$(ls -A "$BACKUP_ROOT" 2>/dev/null)" ]; then
		info "no backups yet"
		return 0
	fi
	log "Backups in $BACKUP_ROOT:"
	for d in "$BACKUP_ROOT"/*/; do
		[ -d "$d" ] || continue
		_v="$(sed -n 's/^version=//p' "$d/meta" 2>/dev/null)"
		printf '  %s  (%s)\n' "$(basename "$d")" "${_v:-unknown}"
	done
}

do_rollback() { # [--internal]  (--internal: called from do_update, which holds the lock itself)
	need_root
	if [ "${1:-}" != "--internal" ] && lock_is_held; then
		info "another update is in progress; exiting"
		exit 3
	fi
	_b="$(latest_backup)"
	[ -n "$_b" ] || die "no backup to roll back to"
	info "rolling back from $_b"
	service_stop
	# backups record whether tailscale was a symlink into tailscaled
	# (combined layout); pre-flag backups restore as plain files
	_symlink="$(sed -n 's/^symlink=//p' "$_b/meta" 2>/dev/null)"
	for f in tailscaled tailscale; do
		if [ "$f" = tailscale ] && [ "$_symlink" = 1 ]; then
			rm -f "$BINDIR/tailscale" && ln -s tailscaled "$BINDIR/tailscale" \
				|| die "restore of tailscale symlink failed"
		elif [ -f "$_b/$f" ]; then
			install_file "$_b/$f" "$BINDIR/$f" 0755 || die "restore of $f failed"
		fi
	done
	service_start
	_v="$(current_version 2>/dev/null)"
	ok "rolled back to ${_v:-unknown}"
	if [ "$MODE" = "rollback" ]; then
		log ""
		"$BINDIR/tailscale" version 2>/dev/null || true
	fi
}

# =========================================================================
# check / update
# =========================================================================
do_check() {
	arch="$(detect_arch 2>/dev/null || true)"
	cur="$(current_version 2>/dev/null || true)"
	latest="$(get_latest_version 2>/dev/null || true)"

	if [ "$JSON_OUT" = 1 ]; then
		_upd=false
		if [ -n "$cur" ] && [ -n "$latest" ] && [ "$(version_gt "$latest" "$cur")" = "1" ]; then
			_upd=true
		fi
		printf '{"installed":"%s","latest":"%s","arch":"%s","kernel":"%s","update_available":%s}\n' \
			"$(json_escape "$cur")" "$(json_escape "$latest")" "$(json_escape "$arch")" \
			"$(uname -m)" "$_upd"
		return 0
	fi

	if [ "$SOURCE" = github ]; then
		[ -n "$latest" ] || die "cannot reach any github source (direct + mirrors); network/DNS?"
	else
		[ -n "$latest" ] || die "cannot reach $BASE_URL (network/DNS?)"
	fi
	log "arch          : $arch ($(uname -m))"
	log "installed     : ${cur:-not installed}"
	log "latest stable : $latest"
	if [ -z "$cur" ]; then
		info "Tailscale is not installed — nothing to update."
	elif [ "$(version_gt "$latest" "$cur")" = "1" ]; then
		ok "update available: $cur -> $latest"
	else
		ok "already up to date ($cur)"
	fi
}

do_update() {
	need_root
	arch="$(detect_arch)" || die "unsupported architecture: $(uname -m); use --arch"
	if [ "$SOURCE" = github ] && [ "$arch" = riscv64 ]; then
		die "source 'github' ($GITHUB_REPO) has no riscv64 build; try --source official"
	fi
	if [ -n "$TARGET_VERSION" ]; then
		latest="$TARGET_VERSION"
	else
		if [ "$SOURCE" = github ]; then
			latest="$(get_latest_version)" || die "cannot reach any github source (direct + mirrors); network/DNS?"
		else
			latest="$(get_latest_version)" || die "cannot reach $BASE_URL (network/DNS?)"
		fi
	fi
	case "$latest" in *[!0-9.]*|'') die "bad target version: '$latest'";; esac

	cur="$(current_version 2>/dev/null || true)"
	info "arch=$arch  installed=${cur:-none}  target=$latest  source=$SOURCE"

	if [ -n "$cur" ] && [ "$FORCE" != 1 ] && [ "$(version_gt "$latest" "$cur")" != "1" ]; then
		ok "already up to date ($cur). use --force to reinstall."
		return 0
	fi

	gh_asset=""
	gh_sums="SHA256SUMS.txt"
	if [ "$SOURCE" = github ]; then
		vanilla_decide
		if [ "$VANILLA_MODE" = 1 ]; then
			gh_asset="tailscaled-linux-$arch"
			gh_sums="SHA256SUMS-vanilla.txt"
			info "flash has room - using the uncompressed binary (no per-invocation decompress)"
		else
			gh_asset="tailscaled-linux-$arch"
		fi
	fi
	tarball_name="tailscale_${latest}_${arch}.tgz"
	if [ "$DRY_RUN" = 1 ]; then
		log ""
		log "DRY RUN — would perform:"
		if [ "$SOURCE" = github ]; then
			log "  1. download $gh_asset from $GH_ROOT (+ mirrors), first base wins per file"
			log "  2. verify sha256 against SHA256SUMS.txt (per base, fail -> next base)"
			log "  3. stop $INITD"
			log "  4. backup $BINDIR/{tailscale,tailscaled} -> $BACKUP_ROOT/<ts>/"
			log "  5. install combined binary as tailscaled + tailscale symlink"
			log "  6. start $INITD and verify"
		else
			log "  1. download (streamed) $BASE_URL/$tarball_name"
			log "  2. verify sha256 against $BASE_URL/${tarball_name}.sha256 while extracting"
			log "  3. stop $INITD"
			log "  4. backup $BINDIR/{tailscale,tailscaled} -> $BACKUP_ROOT/<ts>/"
			log "  5. install both binaries"
			log "  6. start $INITD and verify"
		fi
		return 0
	fi

	if [ "$ASSUME_YES" != 1 ]; then
		printf 'Update Tailscale %s -> %s on %s? [y/N] ' "${cur:-none}" "$latest" "$arch"
		read -r _ans 2>/dev/null || _ans=n
		case "$_ans" in y|Y|yes|YES) ;; *) info "aborted"; return 0 ;; esac
	fi

	workdir="$(prepare_workdir)"

	if ! acquire_lock; then
		rm -rf "$workdir"
		info "another update is in progress; exiting"
		exit 3
	fi
	_fifo=""
	trap '[ -z "${_hb:-}" ] || kill "$_hb" 2>/dev/null; rm -rf "$workdir" "$LOCK_DIR"; [ -z "${_fifo:-}" ] || rm -f "$_fifo"' EXIT INT TERM
	# heartbeat: refresh the lock mtime so a slow-but-steady download
	# (official tarball over a slow WAN can outlast the 30-min budget) is
	# not treated as crashed and stolen. The watcher exits with the parent
	# (kill -0), so SIGKILL cannot leave an immortal lock behind.
	( while :; do
		sleep 60
		kill -0 "$PPID" 2>/dev/null || exit 0
		[ -d "$LOCK_DIR" ] || exit 0
		touch "$LOCK_DIR/held" 2>/dev/null || exit 0
	done ) &
	_hb=$!

	if [ "$SOURCE" = github ]; then
		# checksum file: first base with a usable entry wins; 3x retry like
		# the version probe (release CDN redirects occasionally flake)
		_want=""
		if [ "$VANILLA_MODE" = 1 ]; then
			_sums="$(fetch_retry "$(vanilla_url "$gh_sums")")"
			_want="$(printf '%s\n' "$_sums" | awk -v f="$gh_asset" 'NF >= 2 && $NF == f { print $1; exit }')"
		else
			for _base in $(gh_bases); do
				_sums="$(fetch_retry "$(gh_url "$_base" "$gh_sums")")"
				# match by last field: busybox grep may lack -o/interval
				# expressions; the sha256 comparison below validates anyway
				_want="$(printf '%s\n' "$_sums" | awk -v f="$gh_asset" 'NF >= 2 && $NF == f { print $1; exit }')"
				[ -n "$_want" ] && break
			done
		fi
		if [ -z "$_want" ]; then
			err "cannot fetch a checksum entry for $gh_asset from any source"
			err "refusing to install an unverifiable binary"
			die "refusing to install: checksum failed"
		fi
		_want="$(printf '%s' "$_want" | tr 'A-F' 'a-f')"

		# binary: fetch and verify against the checksum entry
		_bin_ok=""
		if [ "$VANILLA_MODE" = 1 ]; then
			info "downloading $gh_asset from $VANILLA_ROOT"
			if fetch_file "$(vanilla_url "$gh_asset")" "$workdir/$gh_asset"; then
				_got="$(_sha256_of "$workdir/$gh_asset" 2>/dev/null | tr 'A-F' 'a-f')"
				if [ -n "$_got" ] && [ "$_got" = "$_want" ]; then
					ok "checksum ok  sha256=$_got"
					_bin_ok=1
				else
					warn "checksum mismatch from $VANILLA_ROOT"
				fi
			fi
		else
			for _base in $(gh_bases); do
				info "downloading $gh_asset from $_base"
				if fetch_file "$(gh_url "$_base" "$gh_asset")" "$workdir/$gh_asset"; then
					_got="$(_sha256_of "$workdir/$gh_asset" 2>/dev/null | tr 'A-F' 'a-f')"
					if [ -n "$_got" ] && [ "$_got" = "$_want" ]; then
						ok "checksum ok  sha256=$_got"
						_bin_ok=1
						break
					fi
					warn "checksum mismatch from $_base, trying next source..."
				fi
			done
		fi
		[ -n "$_bin_ok" ] || die "refusing to install: checksum failed on all sources"

		chmod 755 "$workdir/$gh_asset"
		srcdir="$workdir"
		gh_mode=1
	else
		# stream the official tarball into extraction (downloader | tee fifo
		# | sha256sum; tar reads the fifo) - no full .tgz on disk. The
		# checksum gates before backup/stop/install, so a corrupt stream is
		# refused as before; peak scratch drops by the tarball size.
		srcdir="$workdir/tailscale_${latest}_${arch}"

		_want="$(fetch_retry "$BASE_URL/${tarball_name}.sha256" \
			| awk '{ print $1; exit }')"
		if [ -z "$_want" ]; then
			err "cannot fetch published checksum for $tarball_name"
			err "refusing to install an unverifiable tarball"
			die "refusing to install: checksum failed"
		fi
		_want="$(printf '%s' "$_want" | tr 'A-F' 'a-f')"
		if ! have sha256sum && ! have busybox && ! have openssl; then
			die "no sha256 tool available; refusing to stream unverified tarball"
		fi

		# keep the fifo in /tmp: it holds no data, but the scratch dir may
		# lack fifo support (FAT32 USB sticks, drvfs)
		_fifo="${TMPDIR:-/tmp}/tsn-stream.$$.fifo"
		_gotfile="$workdir/stream.sha256"
		rm -f "$_fifo" "$_gotfile"
		mkfifo "$_fifo" 2>/dev/null || die "cannot create stream fifo ($_fifo)"

		info "downloading $tarball_name (streamed)"
		( cd "$workdir" && tar xzf "$_fifo" ) &
		_tar_pid=$!
		fetch_stdout "$BASE_URL/$tarball_name" | tee "$_fifo" | sha256sum | awk '{print $1}' > "$_gotfile"
		wait "$_tar_pid" 2>/dev/null || _tar_failed=1

		_got="$(cat "$_gotfile" 2>/dev/null | tr 'A-F' 'a-f')"
		if [ -z "$_got" ] || [ "$_got" != "$_want" ]; then
			err "checksum mismatch!"
			err "  expected $_want"
			err "  got      ${_got:-<empty>}"
			die "refusing to install: checksum failed"
		fi
		ok "checksum ok  sha256=$_got"
		[ "${_tar_failed:-0}" = 1 ] && die "extract failed"

		[ -f "$srcdir/tailscaled" ] || die "tailscaled missing from archive"
		[ -f "$srcdir/tailscale" ]  || die "tailscale missing from archive"
		gh_mode=0
	fi

	make_backup "$cur"

	service_stop

	# install with rollback-on-failure
	fail=0
	if [ "$gh_mode" = 1 ]; then
		# combined binary: real file as tailscaled, symlink for the CLI
		install_file "$srcdir/$gh_asset" "$BINDIR/tailscaled" 0755 || fail=1
		[ "$fail" = 0 ] && { rm -f "$BINDIR/tailscale"; ln -s tailscaled "$BINDIR/tailscale" || fail=1; }
	else
		install_file "$srcdir/tailscaled" "$BINDIR/tailscaled" 0755 || fail=1
		[ "$fail" = 0 ] && { rm -f "$BINDIR/tailscale"; install_file "$srcdir/tailscale" "$BINDIR/tailscale" 0755 || fail=1; }
	fi
	if [ "$fail" != 0 ]; then
		err "install failed — rolling back"
		do_rollback --internal
		die "update failed; previous version restored"
	fi
	ok "binaries installed to $BINDIR"

	service_start

	new="$(current_version 2>/dev/null || true)"
	# some builds stamp a suffix after the base version (combined binary
	# reports 1.104.7-dev20261112 for version.txt 1.104.7): compare base
	# versions only; an empty read still fails
	new_base="${new%%-*}"
	if [ -z "$new" ] || [ "$new_base" != "$latest" ]; then
		err "verification failed: '$new' != '$latest' — rolling back"
		do_rollback --internal
		die "update failed; previous version restored"
	fi
	ok "now running Tailscale $new"

	hold_package

	mkdir -p "$CONFDIR"
	printf 'version=%s\ninstalled_at=%s\narch=%s\nbackup=%s\n' \
		"$new" "$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date)" "$arch" "$BACKUP_DIR" \
		> "$STATE_FILE"

	# best-effort status line
	if [ "$NO_SERVICE" != 1 ] && [ -x "$BINDIR/tailscale" ]; then
		# first meaningful (non "#" comment) line of `tailscale status`
		_st="$("$BINDIR/tailscale" status 2>&1 | awk 'NF && $0 !~ /^#/ {print; exit}')"
		[ -n "$_st" ] && info "status: $_st"
	fi
	log ""
	ok "Tailscale updated to $new  (rollback: $PROG --rollback)"
}

# =========================================================================
# background start (for the LuCI frontend)
# =========================================================================
do_start() {
	if lock_is_held; then
		info "another update is in progress; exiting"
		exit 3
	fi
	: > "$LOG_FILE"; rm -f "$RC_FILE"
	printf 'running\n' > "$UI_STATUS_FILE"
	printf '[i] %s started %s\n' "$APP" "$(date)" >> "$LOG_FILE"
	# flags forward via TS_*_FOR_BG env (no quoting needed in the detached
	# shell); TS_* overrides propagate through the environment on their own
	export TS_TARGET_FOR_BG="$TARGET_VERSION"
	export TS_WORKDIR_FOR_BG="$WORKDIR_OVERRIDE"
	export TS_BASE_URL_FOR_BG="$BASE_URL"
	export TS_SOURCE_FOR_BG="$SOURCE"
	export TS_ARCH_FOR_BG="$ARCH_OVERRIDE"
	export TS_BINDIR_FOR_BG="$BINDIR"
	export TS_NO_HOLD_FOR_BG="$NO_HOLD"
	export TS_MIRROR_LIST_FOR_BG="$MIRROR_LIST_FILE"
	# detach fully so rpcd reaches pipe-EOF immediately (else it blocks
	# until the update ends and the browser XHR times out): setsid, else
	# busybox start-stop-daemon -b, else a plain background job.
	_cmd="'$PROG' --yes --background >>'$LOG_FILE' 2>&1; echo \$? >'$RC_FILE'"
	if have setsid; then
		setsid sh -c "$_cmd" </dev/null >/dev/null 2>&1 &
	elif have start-stop-daemon; then
		start-stop-daemon -S -b -q -x /bin/sh -- -c "$_cmd" </dev/null >/dev/null 2>&1
	else
		sh -c "$_cmd" </dev/null >/dev/null 2>&1 &
	fi
	printf '{"started":true,"log":"%s"}\n' "$LOG_FILE"
}

do_background() {
	TARGET_VERSION="${TS_TARGET_FOR_BG:-$TARGET_VERSION}"
	WORKDIR_OVERRIDE="${TS_WORKDIR_FOR_BG:-$WORKDIR_OVERRIDE}"
	BASE_URL="${TS_BASE_URL_FOR_BG:-$BASE_URL}"
	SOURCE="${TS_SOURCE_FOR_BG:-$SOURCE}"
	ARCH_OVERRIDE="${TS_ARCH_FOR_BG:-$ARCH_OVERRIDE}"
	BINDIR="${TS_BINDIR_FOR_BG:-$BINDIR}"
	NO_HOLD="${TS_NO_HOLD_FOR_BG:-$NO_HOLD}"
	MIRROR_LIST_FILE="${TS_MIRROR_LIST_FOR_BG:-$MIRROR_LIST_FILE}"
	ASSUME_YES=1
	if ( do_update ); then
		printf 'done\n' > "$UI_STATUS_FILE"
		exit 0
	else
		_rc=$?
		if [ "$_rc" = 3 ]; then
			printf 'skipped\n' > "$UI_STATUS_FILE"
		else
			printf 'failed\n' > "$UI_STATUS_FILE"
		fi
		exit "$_rc"
	fi
}

# =========================================================================
# arg parsing
# =========================================================================
parse_args() {
	while [ $# -gt 0 ]; do
		case "$1" in
			-c|--check)      MODE="check" ;;
			-v|--version)    shift; TARGET_VERSION="${1:-}"; [ -n "$TARGET_VERSION" ] || die "-v needs an argument" ;;
			--latest)        TARGET_VERSION="" ;;
			-n|--dry-run)    DRY_RUN=1 ;;
			-f|--force)      FORCE=1 ;;
			-y|--yes)        ASSUME_YES=1 ;;
			-a|--arch)       shift; ARCH_OVERRIDE="${1:-}"; [ -n "$ARCH_OVERRIDE" ] || die "-a needs an argument" ;;
			--source)        shift; SOURCE="${1:-}"; SOURCE_EXPLICIT=1
			                 case "$SOURCE" in github|official) ;; *) die "--source must be 'github' or 'official'" ;; esac ;;
			--base-url)      shift; BASE_URL="${1:-}"; HAVE_BASE_URL=1; [ -n "$BASE_URL" ] || die "--base-url needs an argument" ;;
			--mirror-list)   shift; MIRROR_LIST_FILE="${1:-}"; [ -n "$MIRROR_LIST_FILE" ] || die "--mirror-list needs an argument" ;;
			--no-hold)       NO_HOLD=1 ;;
			--bindir)        shift; BINDIR="${1:-}"; [ -n "$BINDIR" ] || die "--bindir needs an argument" ;;
			--workdir)       shift; WORKDIR_OVERRIDE="${1:-}"; [ -n "$WORKDIR_OVERRIDE" ] || die "--workdir needs an argument" ;;
			--rollback)      MODE="rollback" ;;
			--list-backups)  MODE="list-backups" ;;
			--json)          JSON_OUT=1 ;;
			--start)         MODE="start" ;;
			--background)    MODE="background" ;;
			-h|--help)       usage; exit 0 ;;
			*)               die "unknown option: $1 (try --help)" ;;
		esac
		shift
	done
}

main() {
	parse_args "$@"
	# --base-url means an official-layout mirror unless --source said otherwise
	if [ "$SOURCE_EXPLICIT" != 1 ] && [ "$HAVE_BASE_URL" = 1 ]; then
		SOURCE="official"
	fi
	# concurrency guard: bail if another non-background run is live
	# (.status=running, .rc empty); a log untouched 30+ min = crashed run
	if [ "$MODE" != "background" ] && [ -f "$UI_STATUS_FILE" ] \
	   && [ "$(cat "$UI_STATUS_FILE" 2>/dev/null)" = "running" ] && [ ! -s "$RC_FILE" ]; then
		if [ ! -f "$LOG_FILE" ] || [ -z "$(find "$LOG_FILE" -mmin -30 2>/dev/null)" ]; then
			warn "stale running state (crashed update?); clearing and continuing"
			rm -f "$UI_STATUS_FILE"
		else
			info "another update is in progress; exiting"
			exit 3
		fi
	fi
	case "$MODE" in
		check)         do_check ;;
		list-backups)  do_list_backups ;;
		rollback)      do_rollback ;;
		start)         do_start ;;
		background)    do_background ;;
		update)        do_update ;;
		*)             die "bad mode" ;;
	esac
}

main "$@"
