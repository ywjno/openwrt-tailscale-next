# Stub of /etc/rc.common for off-device init.d testing. Sourced BEFORE the
# init script; config_* read KEY=VALUE lines from $FIXTURE, procd_* append
# to $OUT; the caller then invokes start_service / stop_service directly.

: "${FIXTURE:?FIXTURE (key=value file) required}"
: "${OUT:?OUT (procd log file) required}"

# shellcheck disable=SC1090
if [ -r "$FIXTURE" ]; then . "$FIXTURE"; fi

logger() { :; }

config_load() { :; }

config_get() { # var section option default
	eval "$1=\"\${$3:-$4}\""
}

config_get_bool() { # var section option default
	eval "$1=\"\${$3:-$4}\""
}

config_foreach() { # func [type]
	$1 settings
}

procd_open_instance()  { :; }
procd_close_instance() { :; }
procd_set_param() {      # records "procd set <args>"
	echo "procd set $*" >> "$OUT"
}
procd_append_param() {   # records "procd append <args>"
	echo "procd append $*" >> "$OUT"
}
